# ==========================================
# PHP FreeBase - Environment Configuration
# ==========================================
# Copy this file to .env and adjust the values for your environment.
# Never commit your real .env file to version control.

# Application Environment ('development' or 'production')
APP_ENV=development
APP_NAME="PHP FreeBase"
APP_URL=http://localhost:8000

# Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=freebase
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session & Security Settings
SESSION_NAME=freebase_sec_session
SESSION_LIFETIME=3600            # Idle timeout in seconds (1 hour)
SESSION_MAX_LIFETIME=28800       # Absolute timeout in seconds (8 hours)

# Brute Force Protection (Database-backed)
LOGIN_MAX_ATTEMPTS=5             # Max failed attempts before lockout
LOGIN_LOCKOUT_SECONDS=300        # Lockout duration in seconds (5 minutes)

# Timezone
APP_TIMEZONE=Europe/Madrid
